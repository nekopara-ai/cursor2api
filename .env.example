# cursor2api local configuration
# Copy to `.env` (gitignored) or `export` these in your shell.
# Do not put real tokens, cookies, or proxy passwords in this file.

# --- HTTP server ---
# BIND=127.0.0.1
# PORT=8787
# Require clients to send x-api-key / Authorization. Empty = no gate (default).
# API_KEY=sk-local
# DEFAULT_MODEL=claude-fable-5

# --- Cursor credentials (pick one) ---
# CURSOR_API_KEY=crsr_...
# CURSOR_ACCESS_TOKEN=
# CURSOR2API_CREDENTIALS=/path/to/credentials.json
# CURSOR2API_USE_CLI_AUTH=1
# CURSOR2API_AUTO_LOGIN=1

# --- Usage pool / client identity ---
# cli  = Cursor plan included/bonus pool (default)
# sand = Grok Bot weekly pool (same token, different x-cursor-client-type)
# CURSOR2API_CLIENT_TYPE=cli

# Must remain a real Cursor CLI build id. A Grok Bot desktop version here is
# rejected with permission_denied because this proxy speaks AgentService/Run.
# CURSOR_CLI_VERSION=cli-2026.08.11-e8db854

# --- Egress ---
# HTTP CONNECT proxy for the HTTP/2 stream to Cursor (optional).
# CURSOR2API_PROXY=http://127.0.0.1:8080
# https_proxy=http://127.0.0.1:8080

# --- Behaviour ---
# CURSOR2API_WEB=1
# CURSOR2API_THINKING=auto
# CURSOR2API_LIVE_TTL=150
# CURSOR2API_POOL=2
# CURSOR2API_POOL_IDLE=40
# IDLE_STOP=180
# FIRST_TIMEOUT=90
# No user-visible output after the upstream started answering; cut the
# stream instead of floating to hard_timeout as a zero-output success.
# FIRST_OUTPUT_TIMEOUT=240
# PING_INTERVAL=5
# SANDBOX_SHELL=0
