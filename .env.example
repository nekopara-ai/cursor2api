# cursor2api environment reference
#
# The application does not load this file automatically. Copy only the settings
# you need into your shell, service manager, or a protected environment file.
# Never commit real tokens, API keys, account data, or proxy passwords.

# HTTP service ---------------------------------------------------------------
# BIND=127.0.0.1
# PORT=8787
# Protects POST routes through x-api-key or Authorization: Bearer.
# GET and HEAD routes are not protected by this value.
# API_KEY=local-development-key
# DEFAULT_MODEL=claude-fable-5

# Cursor credentials ---------------------------------------------------------
# Resolution order: access token, API key, cursor2api store, Cursor CLI auth.
# CURSOR_ACCESS_TOKEN=
# CURSOR_API_KEY=crsr_...
# CURSOR2API_CREDENTIALS=/absolute/path/to/credentials.json
# CURSOR2API_USE_CLI_AUTH=1
# CURSOR2API_AUTO_LOGIN=1
# XDG_CONFIG_HOME=/absolute/path/to/config

# Upstream endpoint overrides ------------------------------------------------
# Testing only: these endpoints receive authentication requests or credentials.
# CURSOR_API_BASE_URL=https://api2.cursor.sh
# CURSOR_WEBSITE_URL=https://cursor.com
# CURSOR_AISERVER_URL=https://api2.cursor.sh
# Sand control plane; receives the Cursor access token.
# CURSOR_GROKBOT_URL=https://api2.cursor.sh

# HTTP/2 transport and proxy -------------------------------------------------
# CURSOR2API_PROXY=http://127.0.0.1:8080
# https_proxy=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080
# CURSOR2API_POOL=2
# CURSOR2API_POOL_IDLE=40
# CURSOR2API_SEND_TIMEOUT=120

# Session and client identity ------------------------------------------------
# CURSOR2API_LIVE_TTL=150
# caller: expose only caller-declared executable tools.
# cursor: legacy Cursor builtin-tool compatibility path.
# CURSOR2API_TOOL_OWNER=caller
# Experimental. Model prefixes can override this per request.
# CURSOR2API_CLIENT_TYPE=cli
# Must remain a compatible Cursor CLI build ID for this protocol generation.
# CURSOR_CLI_VERSION=cli-2026.08.11-e8db854

# Sand Stream ----------------------------------------------------------------
# Private desktop-version contract for InferenceService/Stream.
# CURSOR_DESKTOP_VERSION=3.18.9
# Optional checksum machine ids; otherwise derived from the session token.
# CURSOR_MACHINE_ID=
# CURSOR_MAC_MACHINE_ID=

# Request behavior -----------------------------------------------------------
# Server-side web flags apply only to legacy tool-owner mode.
# CURSOR2API_WEB=1
# CURSOR2API_THINKING=auto

# Timeouts and keepalives, in seconds ---------------------------------------
# IDLE_STOP=180
# FIRST_TIMEOUT=90
# FIRST_OUTPUT_TIMEOUT=240
# CURSOR2API_HTTP_IDLE=300
# PING_INTERVAL=5

# Model catalog cache, in seconds -------------------------------------------
# MODEL_CACHE_TTL=900
# MODEL_CACHE_FAIL_TTL=60

# Limits, logging, and debugging ---------------------------------------------
# Request-body limit in bytes.
# CURSOR2API_MAX_BODY=67108864
# One structured JSON turn record on stderr.
# CURSOR2API_LOG_TURNS=1
# Any non-empty DBG value enables debug output; leave unset to disable.
# DBG=1

# Compatibility sandbox ------------------------------------------------------
# File operations use path rewriting; an enabled shell is not confined to ROOT.
# SANDBOX_ROOT=/absolute/path/to/cursor-sandbox
# Keep disabled for untrusted callers.
# SANDBOX_SHELL=0
# CURSOR_WS=/absolute/path/to/cursor-sandbox
